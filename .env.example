# ─────────────────────────────────────────────────────────────────────────────
# EduSphere Classroom — Environment Variables Template
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in each value below with your own credentials.
# 3. NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL Database
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Recommended managed DB: https://neon.tech (free tier available)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/edusphere

# ─────────────────────────────────────────────────────────────────────────────
# Session Secret — Used to sign session cookies.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────────────────────────────────────
SESSION_SECRET=your_strong_random_secret_here

# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini AI — AI Chat Bot, Lesson Plans, Quiz Generator
# Get API keys at: https://aistudio.google.com/app/apikey
# Add up to 3 free-tier keys for automatic round-robin rotation on rate limits.
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_GEMINI_API_KEY=AIzaSy...
# GOOGLE_GEMINI_API_KEY_2=AIzaSy...
# GOOGLE_GEMINI_API_KEY_3=AIzaSy...

# ─────────────────────────────────────────────────────────────────────────────
# Redis — Session store, Socket.io scaling, email job queue
#
# Local (development):  redis://127.0.0.1:6379
# Upstash (free cloud): rediss://default:<password>@<hostname>.upstash.io:6379
#   → https://upstash.com
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ─────────────────────────────────────────────────────────────────────────────
# AWS S3 — Cloud file storage (assignments, resources, avatars)
# If not set, files are saved locally to ./uploads/ instead.
# Setup: https://docs.aws.amazon.com/AmazonS3/latest/userguide/creating-bucket.html
# ─────────────────────────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=edusphere-uploads

# ─────────────────────────────────────────────────────────────────────────────
# Email — Production delivery via Resend (https://resend.com)
# Free tier: 100 emails/day, 3,000/month. No credit card required.
# Without RESEND_API_KEY the app uses a console mock (safe for development).
# ─────────────────────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...
# EMAIL_FROM=EduSphere Classroom <noreply@yourdomain.com>

# ─────────────────────────────────────────────────────────────────────────────
# OAuth — Google & GitHub login (optional)
# Google: https://console.cloud.google.com → APIs & Services → Credentials
# GitHub: https://github.com/settings/developers
# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# ─────────────────────────────────────────────────────────────────────────────
# App URL — Used in invitation/notification emails
# In production set this to your deployed URL.
# ─────────────────────────────────────────────────────────────────────────────
# APP_URL=https://yourdomain.com
